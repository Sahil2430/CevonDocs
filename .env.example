# AI Provider configuration (openai, gemini, groq)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.2-11b-vision-preview
MODERATION_PROVIDER=auto
MODERATION_MODEL=omni-moderation-latest



# Routing and Threshold settings
REVIEW_THRESHOLD=0.75
MODERATION_THRESHOLD=0.7
MAX_IMAGE_DIMENSION=2048

# Storage and Database paths
UPLOAD_DIR=uploads
DATABASE_PATH=data/cevondocs.db

# Configurable cost per token for cost metrics (e.g. gpt-4o price per token)
COST_PER_TOKEN=0.0000025

